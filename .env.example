# Backend API — subdomainsiz, to'g'ridan-to'g'ri MAIN_API_URL ga so'rov
# yuboradi (mainHttp). SUPERADMIN paneli doim shu instance orqali ishlaydi.
NEXT_PUBLIC_MAIN_API_URL=https://dental.api.ilmtech.uz

# Tenant API so'rovlari uchun protokol (tenantHttp bazaviy URL qismi).
NEXT_PUBLIC_TENANT_API_PROTOCOL=https

# Tenant API root domeni — har bir so'rov {subdomain}.<shu qiymat> ga ketadi
# (masalan https://clinic1.dental.api.ilmtech.uz).
NEXT_PUBLIC_TENANT_API_ROOT_DOMAIN=dental.api.ilmtech.uz

# Tenant API porti. Bo'sh qoldirilsa production'da port qo'shilmaydi;
# NEXT_PUBLIC_TENANT_API_ROOT_DOMAIN=localhost bo'lsa avtomatik 9000 ishlatiladi.
NEXT_PUBLIC_TENANT_API_PORT=

# Frontend root domeni — src/lib/tenant.ts shu qiymat orqali hostname'dan
# subdomain'ni ajratadi (proxy.ts va client tomonidagi getCurrentSubdomain()
# ikkalasi ham shundan foydalanadi). BO'SH QOLSA subdomain aniqlash
# ehtimoliy (label-count) evristikaga tushadi va root domenning o'zi
# noto'g'ri tenant subdomeni deb aniqlanishi mumkin — production'da HAR DOIM
# to'g'ri qiymat bilan to'ldirilishi shart.
NEXT_PUBLIC_FRONTEND_ROOT_DOMAIN=dental.ilmtech.uz

# Frontend'ning o'zi qaysi protokolda ishlashi — register sahifasida
# klinika login havolasini ({subdomain}.<root-domain>/login) qurishda
# ishlatiladi.
NEXT_PUBLIC_FRONTEND_PROTOCOL=https

# To'liq frontend URL — SEO metadata (Open Graph, canonical va h.k.) uchun
# src/app/layout.tsx'da ishlatiladi.
NEXT_PUBLIC_APP_URL=https://dental.ilmtech.uz
